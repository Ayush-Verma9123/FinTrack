# MongoDB connection. Use your MongoDB Atlas URI or local MongoDB URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=fintrack

# Use a long, unique value before deploying.
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated browser origins that may call the API.
CLIENT_URL=http://localhost:5173

# Optional frontend setting. Leave as-is for local development.
VITE_API_URL=http://localhost:3001/api
